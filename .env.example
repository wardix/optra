# ==============================================================================
# 📡 OPTRA - ENVIRONMENT VARIABLES CONFIGURATION TEMPLATE
# ==============================================================================
# Petunjuk: Salin berkas ini menjadi '.env' di folder root dan isi nilainya.
# ==============================================================================

# 🌐 Kredensial & URL API Protelindo (Gateway ONT)
PROTELINDO_AUTH_API_URL=https://api-endpoint.example.com/oauth/token
PROTELINDO_ONT_STATUS_API_URL=https://api-endpoint.example.com/ont/status/detail
PROTELINDO_API_USERNAME=username_mitra_anda
PROTELINDO_API_PASSWORD=password_mitra_anda
PARTNER_SOURCE=NUSANET

# 🌐 Kredensial & URL API NIS Gateway (Subscriber Homepass)
NIS_HOMEPASS_API_URL=https://nis-gateway.example.com/subscriber/fttx-homepasses
NIS_GATEWAY_TOKEN=token_bear_akses_nis_gateway_anda
PROTELINDO_OPERATOR_ID=22

# 💾 Database PostgreSQL Connection String
# Contoh format: postgres://[user]:[password]@[host]:[port]/[database_name]
DATABASE_URL=postgres://postgres:postgres@localhost:5432/optra_db

# 🔌 Konfigurasi Web Server Hono (Dashboard & REST API)
PORT=3000

# ⏱️ Kontrol Kecepatan, Konkurensi & Loop Daemon Pemantau (OPTRA Sweeper)
# - ONT_QUERY_DELAY_MS: Jeda waktu (delay) sequential antar query ONT per worker (Rekomendasi: 500 - 1000 ms)
# - MONITOR_LOOP_INTERVAL_MS: Cooldown daemon untuk tidur sebelum siklus pemindaian berikutnya (300000 ms = 5 menit)
# - MONITOR_MAX_PAGES: Batas maksimal halaman NIS Gateway yang disapu (Set 0 untuk menyapu seluruh pelanggan)
# - MONITOR_CONCURRENCY: Jumlah pekerja (worker) paralel yang berjalan bersamaan mengecek ONT
ONT_QUERY_DELAY_MS=1000
MONITOR_LOOP_INTERVAL_MS=300000
MONITOR_MAX_PAGES=0
MONITOR_CONCURRENCY=5

# ⚡ OPTIMASI LAPIS 1 & 2: Cooldown Pemadaman Listrik & Sinyal Sehat
# - DYING_GASP_SKIP_HOURS: Jeda waktu bypass pengecekan untuk ONT yang mati akibat padam listrik mendadak (jam)
# - GOOD_SIGNAL_SKIP_HOURS: Jeda waktu bypass pengecekan untuk ONT dengan daya terima (Rx) sangat prima (jam)
# - GOOD_SIGNAL_THRESHOLD: Ambang batas daya terima minimum (dBm) untuk diklasifikasikan sebagai sinyal prima
DYING_GASP_SKIP_HOURS=8
GOOD_SIGNAL_SKIP_HOURS=6
GOOD_SIGNAL_THRESHOLD=-20

# 🕒 OPTIMASI LAPIS 3: Progressive Exponential Backoff untuk ONT Offline (dalam menit)
# - Range 1-6 Jam: Waktu cooldown sebelum pengecekan ulang ONT yang mati selama 1 s.d 6 jam terakhir
# - Range 6-24 Jam: Waktu cooldown sebelum pengecekan ulang ONT yang mati selama 6 s.d 24 jam terakhir
# - Range > 24 Jam: Waktu cooldown sebelum pengecekan ulang ONT yang mati di atas 24 jam (misal isolir/kabel putus)
OFFLINE_BACKOFF_1_TO_6_HOURS_SKIP_MINUTES=60
OFFLINE_BACKOFF_6_TO_24_HOURS_SKIP_MINUTES=240
OFFLINE_BACKOFF_ABOVE_24_HOURS_SKIP_MINUTES=720
